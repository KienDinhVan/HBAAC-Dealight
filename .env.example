POSTGRES_DB=sku_forecasting
POSTGRES_USER=forecast
POSTGRES_PASSWORD=replace-with-a-strong-password
# URL encoded form of POSTGRES_PASSWORD, required in MLflow/Airflow database URLs.
POSTGRES_PASSWORD_URLENCODED=replace-with-a-strong-password
POSTGRES_PORT=5432

API_PORT=8000
# Comma-separated list of origins allowed by the FastAPI CORS middleware.
# Empty (default) means no CORS middleware is registered (same-origin only).
CORS_ORIGINS=
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=replace-with-a-strong-minio-password
MLFLOW_PORT=5000
MLFLOW_BUCKET=mlflow
AIRFLOW_PORT=8080
AIRFLOW_UID=50000
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=replace-with-a-strong-airflow-password
AIRFLOW_WEBSERVER_SECRET_KEY=replace-with-a-long-random-secret
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-a-strong-grafana-password
PROMETHEUS_PORT=9090

# PoC only: submission loader is started explicitly with the `poc` profile.
PRODUCTION_SUBMISSION_PATH=data/artifacts/submission_FINAL_twostage_top300_lb730_s7_b1200_seedens20_alpha0.575_keysku_cautious_mapoldnew_a0.05.csv
FORECAST_DATE=2025-09-05
FORECAST_RUN_ID=submission-final-public-048729-20250905
MODEL_NAME=twostage-seed-ensemble-mapoldnew
MODEL_VERSION=public-0.48729

# Switch to the best recorded public submission by replacing the five values above with:
# PRODUCTION_SUBMISSION_PATH=data/artifacts/submission_twostage_active_recent_top_profit_top300_a50_r56_lb730_s7_tc_sun0_eos0_b900_2025-09-05_alpha0.60_keysku_cautious.csv
# FORECAST_RUN_ID=submission-best-public-048694-20250905
# MODEL_NAME=twostage-keysku-cautious
# MODEL_VERSION=public-0.48694

# --- Sprint 9 — Workspace Web (Predict / Dashboard / Drift / Chat) ---------
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash-preview-05-20
ENABLE_AGENTS=true
INLINE_PREDICT_MAX_ROWS=50000
MLFLOW_MODEL_URI=
WEB_PORT=4000

# --- DE GCS pipeline (DE_arch) — upload CSV -> Airflow -> GCS -> BigQuery ---
# Run scripts/setup_gcp.sh to create these resources and the key file.
GCP_PROJECT_ID=
GCS_BUCKET=
BQ_DATASET=dealight
MAX_UPLOAD_BYTES=104857600
# Key file must exist at infra/secrets/gcp-key.json (mounted read-only into containers).
